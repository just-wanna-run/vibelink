# JWT Secret Key
JWT_SECRET=vibelink-prod-change-me-to-a-random-string

# Server Port
PORT=3001

# YunPian SMS (optional — dev mode shows code in popup)
# Sign up at https://www.yunpian.com to get your API key
# SMS_API_KEY=your-yunpian-api-key

# Cloudflare R2 (for large file storage — optional)
# R2_ACCESS_KEY_ID=your-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET_NAME=vibelink-files
# R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
