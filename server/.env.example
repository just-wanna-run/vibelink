# JWT Secret Key
JWT_SECRET=vibelink-prod-change-me-to-a-random-string

# Server Port
PORT=3001

# Alibaba Cloud SMS (optional — dev mode shows code in popup)
# SMS_ACCESS_KEY_ID=your-access-key-id
# SMS_ACCESS_KEY_SECRET=your-access-key-secret
# SMS_SIGN_NAME=VibeLink
# SMS_TEMPLATE_CODE=SMS_123456789

# Cloudflare R2 (for large file storage — optional)
# R2_ACCESS_KEY_ID=your-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET_NAME=vibelink-files
# R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
