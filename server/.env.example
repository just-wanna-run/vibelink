# JWT Secret Key — change this to a random string in production
JWT_SECRET=vibelink-prod-change-me-to-a-random-string

# Server Port
PORT=3001

# Cloudflare R2 (for large file storage — optional, files stored locally by default)
# R2_ACCESS_KEY_ID=your-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET_NAME=vibelink-files
# R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
